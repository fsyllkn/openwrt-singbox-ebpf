{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": true,
      "store_dns": true,
      "cache_id": "linux-singbox-openwrt"
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "/opt/sing-box/board/dist",
      "external_ui_download_url": "https://github.com/zephyruso/zashboard/releases/latest/download/dist-no-fonts.zip",
      "default_mode": "Rule"
    }
  },
  "http_clients": [
    {
      "tag": "http_cli",
      "detour": "proxy"
    }
  ]
}
