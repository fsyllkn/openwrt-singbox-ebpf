{
  "inbounds": [
    {
      "type": "ebpf",
      "local": {
        "enabled": true,
        "data_plane": "cgroup",
        "dns_mode": "respect_policy",
        "ipv6": true,
        "bypass_private_address": false,
        "include_uid": [],
        "exclude_uid": [],
        "exclude_uid_range": []
      },
      "network": [
        "tcp",
        "udp"
      ],
      "udp_timeout": "5m"
    },
    {
      "type": "mixed",
      "tag": "lan-mixed",
      "listen": "127.0.0.1",
      "listen_port": 7891,
      "users": []
    }
  ]
}
