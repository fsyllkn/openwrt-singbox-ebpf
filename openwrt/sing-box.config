# /etc/config/sing-box
# OpenWrt UCI configuration template for sing-box eBPF

config sing-box 'main'
	option enabled '1'
	option service_dir '/opt/sing-box'
	option config_file '/opt/sing-box/config/config.json'
	option auto_dns '1'
# The installer records source_dir for updates. Gateway interface/subnet are
# explicitly selected per device and stored in runtime/gateway.json.
